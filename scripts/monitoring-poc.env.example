# ==========================================================================
# systemd EnvironmentFile for monitoring-poc.service.
# Copy this to /etc/monitoring-poc/monitoring-poc.env on the server, fill in
# real values, then: chmod 600 (root-only readable - it holds secrets).
# ==========================================================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/monitoring_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- Secrets: generate fresh values, never reuse the repo defaults ---
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# openssl rand -base64 32 | head -c 32
MASTER_KEY=CHANGE_ME
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Reachability ---
# Must be the real host/IP monitored agents can reach this server on.
APP_INGEST_BASE_URL=http://CHANGE_ME:8080

# --- Storage ---
APP_STORAGE_ROOT=/data01

# --- Ollama (AIOps module) ---
# Only override if Ollama runs on a different host than this app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# --- Mail ---
# Set to false if the corporate SMTP relay isn't reachable from this server.
MAIL_ENABLED=true

# ==========================================================================
# Copy to .env and fill in real values before running docker compose (or
# any deployment method) against anything beyond local/dev testing.
# .env is git-ignored - never commit real secrets or internal addresses.
# ==========================================================================

# --- Server ---
SERVER_PORT=8080

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://postgres:5432/monitoring_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- JWT ---
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_bytes_random_value
JWT_EXPIRATION_MS=43200000

# --- AES-256-GCM master key, encrypts per-server HMAC secrets at rest ---
# Generate: openssl rand -base64 32 | head -c 32
MASTER_KEY=CHANGE_ME_random_passphrase_for_aes_key_derivation

# --- HMAC ingestion anti-replay window (seconds) ---
HMAC_WINDOW_SECONDS=300

# --- Email-based 2FA kill-switch. Keep false until SMTP delivery is
# verified end-to-end for your environment. ---
TWO_FA_ENABLED=false

# --- "Fetch Now" bounded poll tuning (defaults are usually fine) ---
METRICS_FETCH_POLL_INTERVAL_MS=300
METRICS_FETCH_POLL_MAX_ATTEMPTS=26
METRICS_FETCH_TIMEOUT_MINUTES=2

# --- Bootstrap admin (seeded once on first boot if no ADMIN exists yet) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@monitoring.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Storage root for provisioning artifacts / logs ---
APP_STORAGE_ROOT=/data01

# --- Reachable address of THIS machine (running docker compose) from the
# monitored target hosts' network - baked into each agent's agent_config.json
# as its ingestUrl at provisioning time. localhost/127.0.0.1 does NOT work
# here since the agent runs on the remote target, not on this machine. ---
APP_INGEST_BASE_URL=http://YOUR_SERVER_IP:8080

# --- SMTP mail (2FA OTP delivery + async system alerts) ---
# Set MAIL_ENABLED=false if no SMTP relay is reachable from this environment.
SMTP_HOST=smtp.example.com
MAIL_FROM=monitoring-noreply@example.com
MAIL_ENABLED=true

# --- Ollama (AIOps module, fully offline LLM) ---
# Only override if Ollama runs on a different host than this app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=45

# --- AIOps scan cadence and critical thresholds (%) ---
AIOPS_SCAN_INTERVAL_MS=300000
AIOPS_CRITICAL_CPU_THRESHOLD=90
AIOPS_CRITICAL_RAM_THRESHOLD=90
AIOPS_CRITICAL_DISK_THRESHOLD=90
